<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00ACC1"
    android:padding="24dp"
    tools:context=".Message.Tutorial.Tutorial1Fragment">

    <!-- Gambar / Ilustrasi Utama -->
    <ImageView
        android:id="@+id/imgTutorial1"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="60dp"
        android:contentDescription="Ilustrasi Chat"
        android:src="@drawable/ic_info"
        app:tint="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Judul Informasi -->
    <TextView
        android:id="@+id/tvTitleTutorial1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:gravity="center"
        android:text="Kirim Pesan Instant"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgTutorial1" />

    <!-- Deskripsi Singkat -->
    <TextView
        android:id="@+id/tvDescTutorial1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Nikmati kemudahan berkomunikasi secara cepat, aman, dan tanpa hambatan langsung dari aplikasi."
        android:textColor="#E0E0E0"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitleTutorial1" />

</androidx.constraintlayout.widget.ConstraintLayout>